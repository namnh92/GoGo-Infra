# GoGo DEV observability host — 192.168.68.168 (ADR-0007 §E1/§E2).
# Copy to `.env` on that machine and fill in every placeholder. `.env` is
# gitignored and stays on the host: §E8 holds DEV to production's secret
# discipline, so nothing here is ever committed or baked into an image.
#
# After editing, run `bin/render-web-config.sh` — Prometheus' basic-auth files
# are generated from these values, not written by hand.

# The address the containers publish on. NEVER 0.0.0.0: this host sits on a LAN
# that §E8 treats as a boundary rather than a trusted zone, and an unset or
# wildcard bind publishes a remote-write receiver to every interface the
# machine has. The compose file refuses to start without it.
OBS_BIND_IP=192.168.68.168
OBS_PUBLIC_HOST=192.168.68.168
GRAFANA_HTTP_PORT=3000
PROMETHEUS_HTTP_PORT=9090

# Pinned, never `latest`, and pinned by digest. §E8: this stack is rebuilt from
# the repository, and a floating tag means the rebuild is not the thing that was
# running. A tag alone only narrows that — `v3.14.0` can be repushed — so the
# digest is what actually makes the rebuild reproducible. The tag stays in front
# of it because `prom/prometheus@sha256:5ce754…` tells a reader nothing.
#
# These are the versions ALREADY RUNNING on 192.168.68.168, captured so that
# adopting this stack changes authentication, networking, persistence and
# retention — and NOT the application version. The first draft pinned v3.5.5 and
# 12.4.10, which would have been a downgrade onto existing TSDB blocks:
# Prometheus reads forward, not backward, so an older binary can refuse blocks a
# newer one wrote. Hardening must not be able to cost the history it is being
# built to protect.
#
# Changing either version is a SEPARATE task with its own backup, compatibility
# check and rollback plan. It is never bundled with a hardening change, because
# then a failed start has two candidate causes and no clean revert.
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0
GRAFANA_IMAGE=grafana/grafana:13.2.1@sha256:f772d434e8fab0049deb2b1b30abd43342bcfca1537614aa8d36080232cf4283

# Bounded retention, appropriate to DEV. Losing this history is not normal
# operation (§E8), but it is not production-scale either — no HA, no PITR.
# Whatever is set here must match METRICS_RETENTION_DAYS on the BE side, or the
# CMS console offers a window this store cannot answer.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# Remote-write and query authentication.
#
# §E4 asked whether bind rules plus the host firewall are sufficient on their
# own, and §E8 supplies the test: would PROD refuse this configuration? PROD
# would refuse an unauthenticated remote-write receiver, so this stack does not
# ship one. The user must match the literal in `prometheus/prometheus.yml`;
# `bin/render-web-config.sh` refuses to run if it does not.
PROMETHEUS_BASIC_AUTH_USER=gogo-obs
PROMETHEUS_BASIC_AUTH_PASSWORD=

# Grafana's own admin. Sign-up is disabled, so this is the only account until
# someone makes another on purpose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=

# --- Administrative-data alerting (ADR-0009 / INF-156) -----------------------
#
# The kill switch for the eighteen rules in
# grafana/provisioning/alerting/administrative-rules.yaml.
#
# `true` until the acceptance run. All 39 administrative series are absent until
# the BE build containing cf5989c is deployed, and the sentinel rule
# (adm-dataset-missing) uses `noDataState: Alerting` on purpose — running it
# before the metrics exist would page on the very first evaluation.
#
# Grafana reads this through values.BoolValue, which expands the environment and
# then calls strconv.ParseBool: an unset or non-boolean value FAILS provisioning
# rather than quietly meaning "not paused". Only `true` or `false`.
#
# Activation is docs/runbook-administrative-alerts.md § Activation — seven
# recorded conditions, then this flag, then a provisioning reload.
GOGO_ADM_ALERTS_PAUSED=true

# The org's existing root notification receiver. Provisioning `policies:`
# REPLACES the whole root policy tree, so this repeats what is already there and
# the administrative route is added underneath it. Change it only if the default
# contact point has been renamed — a name that does not exist fails provisioning.
GOGO_ALERTS_DEFAULT_RECEIVER=grafana-default-email

# The Telegram bot token and chat id are NOT set here. They live in SSM as
# SecureStrings and reach this host through `bin/render-alerting-env.sh`, which
# writes a mode-0600 `.env.alerting` that compose loads into the Grafana
# container alone. See ADR-0009 §F5.
#
#   ./bin/render-alerting-env.sh
