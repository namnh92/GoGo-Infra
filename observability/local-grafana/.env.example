# GoGo DEV observability host — 192.168.68.168 (ADR-0007 §E1/§E2).
# Copy to `.env` on that machine and fill in every placeholder. `.env` is
# gitignored and stays on the host: §E8 holds DEV to production's secret
# discipline, so nothing here is ever committed or baked into an image.
#
# After editing, run `bin/render-web-config.sh` — Prometheus' basic-auth files
# are generated from these values, not written by hand.

# The address the containers publish on. NEVER 0.0.0.0: this host sits on a LAN
# that §E8 treats as a boundary rather than a trusted zone, and an unset or
# wildcard bind publishes a remote-write receiver to every interface the
# machine has. The compose file refuses to start without it.
OBS_BIND_IP=192.168.68.168
OBS_PUBLIC_HOST=192.168.68.168
GRAFANA_HTTP_PORT=3000
PROMETHEUS_HTTP_PORT=9090

# Pinned, never `latest`. §E8: this stack is rebuilt from the repository, and a
# floating tag means the rebuild is not the thing that was running. Moving
# either of these is a deliberate edit with a restore drill behind it.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
GRAFANA_IMAGE=grafana/grafana:12.4.10

# Bounded retention, appropriate to DEV. Losing this history is not normal
# operation (§E8), but it is not production-scale either — no HA, no PITR.
# Whatever is set here must match METRICS_RETENTION_DAYS on the BE side, or the
# CMS console offers a window this store cannot answer.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# Remote-write and query authentication.
#
# §E4 asked whether bind rules plus the host firewall are sufficient on their
# own, and §E8 supplies the test: would PROD refuse this configuration? PROD
# would refuse an unauthenticated remote-write receiver, so this stack does not
# ship one. The user must match the literal in `prometheus/prometheus.yml`;
# `bin/render-web-config.sh` refuses to run if it does not.
PROMETHEUS_BASIC_AUTH_USER=gogo-obs
PROMETHEUS_BASIC_AUTH_PASSWORD=

# Grafana's own admin. Sign-up is disabled, so this is the only account until
# someone makes another on purpose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
