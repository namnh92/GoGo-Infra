{
  "comment": "Scrub V1 oracle (shape D-5, rev 2.1). fn: scrub | scrub-release (keepLongRuns) | path (scrubPathTemplate). Every rule is hit at least twice; one case per permitted field is in worker.test.mjs's sentinel fixture.",
  "cases": [
    { "name": "email in a title", "fn": "scrub", "input": "User nam.nh@example.com could not vote", "expected": "User [email] could not vote" },
    { "name": "email with plus tag", "fn": "scrub", "input": "mail to a+test@sub.domain.vn failed", "expected": "mail to [email] failed" },
    { "name": "jwt in a message", "fn": "scrub", "input": "auth eyJhbGciOi.eyJzdWIi.SflKxwRJ rejected", "expected": "auth [token] rejected" },
    { "name": "jwt at end of line", "fn": "scrub", "input": "bearer=eyJa-b.c_d.e-f", "expected": "bearer=[token]" },
    { "name": "long run with digits", "fn": "scrub", "input": "key Ab12Cd34Ef56Gh78Ij90 leaked", "expected": "key [token] leaked" },
    { "name": "long kebab run (aggressive by design)", "fn": "scrub", "input": "module sentry-discord-relay-worker crashed", "expected": "module [token] crashed" },
    { "name": "long pure-letter word survives", "fn": "scrub", "input": "Internationalizations everywhere", "expected": "Internationalizations everywhere" },
    { "name": "invite path /r/", "fn": "scrub", "input": "GET /r/AbCdEfGhIjKlMnOpQrStUv failed", "expected": "GET /r/[redacted] failed" },
    { "name": "share-link path /l/", "fn": "scrub", "input": "open /l/Af82XcAf82Xc now", "expected": "open /l/[redacted] now" },
    { "name": "invite path /invite/", "fn": "scrub", "input": "at /invite/xyz9 line 3", "expected": "at /invite/[redacted] line 3" },
    { "name": "share-links api path", "fn": "scrub", "input": "api /share-links/slug123 404", "expected": "api /share-links/[redacted] 404" },
    { "name": "query key token", "fn": "scrub", "input": "url ?token=abc&x=1", "expected": "url ?token=[redacted]&x=1" },
    { "name": "query keys lat lng", "fn": "scrub", "input": "map ?lat=10.76262&lng=106.66017", "expected": "map ?lat=[redacted]&lng=[redacted]" },
    { "name": "query key code mid-query", "fn": "scrub", "input": "join ?room=5&code=XYZ12", "expected": "join ?room=5&code=[redacted]" },
    { "name": "coordinate pair", "fn": "scrub", "input": "at 10.762622, 106.660172 now", "expected": "at [geo] now" },
    { "name": "negative coordinate pair", "fn": "scrub", "input": "point -33.8688,151.2093 cached", "expected": "point [geo] cached" },
    { "name": "vn phone 0-prefixed", "fn": "scrub", "input": "call 0912345678 failed", "expected": "call [phone] failed" },
    { "name": "vn phone +84", "fn": "scrub", "input": "otp to +84912345678 sent", "expected": "otp to [phone] sent" },
    { "name": "control chars removed", "fn": "scrub", "input": "line1\u0000\u001fline2", "expected": "line1line2" },
    { "name": "plain text untouched", "fn": "scrub", "input": "TypeError: cannot read plan of room", "expected": "TypeError: cannot read plan of room" },
    { "name": "release sha survives (rev 2.1)", "fn": "scrub-release", "input": "gogo-be@5658159abcdef0123456789abcdef012345678", "expected": "gogo-be@5658159abcdef0123456789abcdef012345678" },
    { "name": "release with email still scrubbed", "fn": "scrub-release", "input": "gogo-be@a@b.com", "expected": "gogo-be@[email]" },
    { "name": "release with invite path still scrubbed", "fn": "scrub-release", "input": "rel /r/AbCdEf12", "expected": "rel /r/[redacted]" },
    { "name": "path template uuid", "fn": "path", "input": "/room/9f1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d/preference", "expected": "/room/[id]/preference" },
    { "name": "path template base64url 16", "fn": "path", "input": "/places/Ab12Cd34Ef56Gh78", "expected": "/places/[id]" },
    { "name": "path template long number", "fn": "path", "input": "/plans/123456789/active", "expected": "/plans/[id]/active" },
    { "name": "path template short number kept", "fn": "path", "input": "/tab/12345/x", "expected": "/tab/12345/x" },
    { "name": "path template plain segments kept", "fn": "path", "input": "/(tabs)/plans", "expected": "/(tabs)/plans" },
    { "name": "path template invite segment via cred rule", "fn": "path", "input": "/r/AbCdEfGhIj", "expected": "/r/[redacted]" }
  ]
}
