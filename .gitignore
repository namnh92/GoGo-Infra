# Terraform
**/.terraform/*
# Lock files are committed for root configurations (environments, bootstrap) so
# CI resolves the same provider versions. Modules are only ever initialised as
# part of a root config, so their locks are noise.
terraform/modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars.local
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl.local
tfplan
*.tfplan

# Secrets — nothing with a real value may ever be committed
.env
.env.*
!.env.example
*.env.runtime
*.p8
*.p12
*.mobileprovision
*-service-account*.json
*serviceaccount*.json
credentials
credentials.json
secrets.auto.tfvars
*.pem
*.key
!**/*.pub

# Node — wrangler is used for R2 bucket operations the Terraform provider
# does not cover. The manifest and lock are committed; the tree is not.
node_modules/

# Local
.DS_Store
.idea/
.vscode/
*.log

# Generated during bootstrap
backend_override.tf

# Operator inputs — the .example is committed, the filled copy is not
config/bootstrap.env
