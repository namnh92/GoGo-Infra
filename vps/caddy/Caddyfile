# Production reverse proxy. INF-018.
#
# Rendered onto the VPS by the deploy pipeline, not edited in place. A change
# made by hand survives until the next deploy and then vanishes, which is the
# worst kind of configuration: it works, and nobody can reproduce why.
#
# Hostnames come from config/bootstrap.env. Caddy provisions TLS itself.

{
	email {$ACME_EMAIL}

	# Access logs are shipped, so they must never carry credentials. Caddy logs
	# request headers only where told to; the filters below are the guarantee.
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy advertises itself by default; there is no reason to tell a
		# scanner which server and version to look up.
		-Server
	}
}

(redacted_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
		}
		format json
		# GOGO_SRS.md §10.2: logs never carry tokens or cookies. Redaction is
		# configured here rather than trusted to the application, because the
		# proxy sees the header whether or not the app logs it.
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Set-Cookie delete
			request>headers>X-Api-Key delete
		}
	}
}

{$API_DOMAIN} {
	import security_headers
	import redacted_log

	# The API is the only thing behind this name. Anything not matched is a 404
	# from Caddy rather than a pass-through to whatever else listens on 3000.
	handle /v1/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /health {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		respond "not found" 404
	}
}

{$CMS_DOMAIN} {
	import security_headers
	import redacted_log

	root * /opt/gogo/cms/current
	encode gzip zstd
	try_files {path} /index.html
	file_server
}
