[Unit]
Description=GoGo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gogo
Group=gogo

# current is a symlink the deploy moves. WorkingDirectory resolves it at start,
# so a restart picks up the new release and a rollback picks up the old one
# without touching this file.
WorkingDirectory=/opt/gogo/current
EnvironmentFile=/opt/gogo/shared/.env.prod
ExecStart=/usr/bin/node dist/main.js

Restart=on-failure
RestartSec=5s

# A crash loop should be visible, not silent. Five failures inside a minute
# stops the unit so the alert fires instead of the service flapping forever.
StartLimitBurst=5
StartLimitIntervalSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gogo/shared
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gogo-api

[Install]
WantedBy=multi-user.target
