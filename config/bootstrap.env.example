# Non-secret operator inputs for the bootstrap scripts.
#
#   cp config/bootstrap.env.example config/bootstrap.env
#   $EDITOR config/bootstrap.env
#   ./scripts/secrets/setup-env.sh dev
#
# NON-SECRET VALUES ONLY. Identifiers, hostnames, package names, project ids —
# things that are safe in a ticket. Every key here is on an allowlist and the
# script refuses anything else, so a token pasted in by mistake is rejected
# rather than quietly written to SSM as a String and left unencrypted.
#
# Secrets are never in this file. setup-env.sh prompts for those without echo
# and writes them as SecureString.
#
# config/bootstrap.env is gitignored. The .example is committed.
#
# PER-ENVIRONMENT VALUES take a suffix: ONESIGNAL_APP_ID_DEV,
# ONESIGNAL_APP_ID_PROD. The unsuffixed name is the fallback. Anything that
# differs between dev and prod must be suffixed — a shared OneSignal App ID
# means a development device receives production pushes, and the two apps end up
# sharing APNs and FCM configuration.
#
# Env-scoped keys: ONESIGNAL_APP_ID, FIREBASE_PROJECT_ID, IOS_BUNDLE_ID,
# ANDROID_PACKAGE_NAME, TENJIN_IOS_SDK_KEY, TENJIN_ANDROID_SDK_KEY,
# CLOUDFLARE_ZONE_ID.

# Which environment the unsuffixed keys below describe. Everything in this file
# without a _DEV/_PROD suffix is treated as belonging to this environment, and
# a key that must differ per environment is refused when read from another one.
#
# Without this, running setup-env.sh prod against a file filled in for dev would
# copy the dev OneSignal App ID into the prod namespace without a word.
UNSUFFIXED_VALUES_BELONG_TO=dev

# ── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=0c279927ff26d9f743923d532e570b7b
CLOUDFLARE_ZONE_ID=
ROOT_DOMAIN=gogo.id.vn
API_DOMAIN=api.gogo.id.vn
CMS_DOMAIN=cms.gogo.id.vn
SHARE_DOMAIN=go.gogo.id.vn
# Per environment: go.dev.gogo.id.vn, go.stag.gogo.id.vn, go.gogo.id.vn
SHARE_DOMAIN_DEV=
SHARE_DOMAIN_STAGING=

# ── R2 application storage ───────────────────────────────────────────────────
# Endpoint is derived from the account id; bucket from the environment.
R2_ENDPOINT=
R2_BUCKET=

# ── OneSignal ────────────────────────────────────────────────────────────────
# The App ID is client configuration and ships in the mobile binary.
# The REST key and identity key are secrets — setup-env.sh prompts for them.
ONESIGNAL_APP_ID=

# ── Apple ────────────────────────────────────────────────────────────────────
# Needed for the APNs setup in OneSignal and for apple-app-site-association.
#
# Three flavours, one scheme: max.gogo.{dev,stag,prod} — see
# GoGo-MobileApp/app.config.ts. They install side by side, so a tester can run
# staging next to the store build. Use the suffixed keys:
#
#   IOS_BUNDLE_ID_DEV=max.gogo.dev
#   IOS_BUNDLE_ID_PROD=max.gogo.prod
#
# Permanent after the first store submission, and baked into
# apple-app-site-association, assetlinks.json and the APNs configuration in
# OneSignal. Only the prod flavour claims https:// links.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
APNS_KEY_ID=

# ── Android ──────────────────────────────────────────────────────────────────
# The SHA-256 fingerprint of the signing certificate goes into assetlinks.json.
ANDROID_PACKAGE_NAME=
# Per environment, and the two come from different places. Dev is the debug
# keystore committed in GoGo-MobileApp:
#
#   ./scripts/bootstrap/android-fingerprint.sh ../GoGo-MobileApp/android/app/debug.keystore
#
# Prod is NOT the upload key. With Play App Signing, Google re-signs the upload,
# so the fingerprint that verifies App Links is the app signing certificate in
# Play Console → Setup → App signing. Using the upload or debug key there fails
# silently: no error, the link just opens in the browser.
ANDROID_SIGNING_SHA256_DEV=
ANDROID_SIGNING_SHA256_PROD=
FIREBASE_PROJECT_ID=

# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=

# ── Tenjin ───────────────────────────────────────────────────────────────────
# One SDK Key per app, from Apps → <app> → SDK Key. Client config: it ships
# inside the mobile binary, so treat it as public. Nothing Tenjin-related goes
# to SSM — GoGo-BE builds tracking URLs by composing a template and does not
# call any authenticated Tenjin API.
#
# The Automation/Reporting APIs use a separate API Access Token (AUTOMATE → API
# Access Tokens). Add it only when something actually calls those.
TENJIN_IOS_SDK_KEY=
TENJIN_ANDROID_SDK_KEY=
IOS_STORE_URL=
ANDROID_STORE_URL=

# ── Production VPS ───────────────────────────────────────────────────────────
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/gogo
HEALTH_URL=

# ── AWS ──────────────────────────────────────────────────────────────────────
# The IAM role Identity Center provisions in THIS account for the developer
# permission set. Not the arn:aws:sso:::instance/... ARN — that identifies the
# directory and grants nothing.
#
#   aws iam list-roles \
#     --query "Roles[?starts_with(RoleName,'AWSReservedSSO')].Arn" --output text
#
# Pick the developer permission set, not the bootstrap administrator one.
DEVELOPER_SSO_PRINCIPAL_ARN=
