# Non-secret operator inputs for the bootstrap scripts.
#
#   cp config/bootstrap.env.example config/bootstrap.env
#   $EDITOR config/bootstrap.env
#   ./scripts/secrets/setup-env.sh dev
#
# NON-SECRET VALUES ONLY. Identifiers, hostnames, package names, project ids —
# things that are safe in a ticket. Every key here is on an allowlist and the
# script refuses anything else, so a token pasted in by mistake is rejected
# rather than quietly written to SSM as a String and left unencrypted.
#
# Secrets are never in this file. setup-env.sh prompts for those without echo
# and writes them as SecureString.
#
# config/bootstrap.env is gitignored. The .example is committed.
#
# PER-ENVIRONMENT VALUES take a suffix: ONESIGNAL_APP_ID_DEV,
# ONESIGNAL_APP_ID_PROD. The unsuffixed name is the fallback. Anything that
# differs between dev and prod must be suffixed — a shared OneSignal App ID
# means a development device receives production pushes, and the two apps end up
# sharing APNs and FCM configuration.
#
# Env-scoped keys: ONESIGNAL_APP_ID, FIREBASE_PROJECT_ID, IOS_BUNDLE_ID,
# ANDROID_PACKAGE_NAME, TENJIN_IOS_SDK_KEY, TENJIN_ANDROID_SDK_KEY,
# CLOUDFLARE_ZONE_ID.

# ── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=0c279927ff26d9f743923d532e570b7b
CLOUDFLARE_ZONE_ID=
ROOT_DOMAIN=gogo.id.vn
API_DOMAIN=api.gogo.id.vn
CMS_DOMAIN=cms.gogo.id.vn
SHARE_DOMAIN=go.gogo.id.vn

# ── R2 application storage ───────────────────────────────────────────────────
# Endpoint is derived from the account id; bucket from the environment.
R2_ENDPOINT=
R2_BUCKET=

# ── OneSignal ────────────────────────────────────────────────────────────────
# The App ID is client configuration and ships in the mobile binary.
# The REST key and identity key are secrets — setup-env.sh prompts for them.
ONESIGNAL_APP_ID=

# ── Apple ────────────────────────────────────────────────────────────────────
# Needed for the APNs setup in OneSignal and for apple-app-site-association.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
APNS_KEY_ID=

# ── Android ──────────────────────────────────────────────────────────────────
# The SHA-256 fingerprint of the signing certificate goes into assetlinks.json.
ANDROID_PACKAGE_NAME=
ANDROID_SIGNING_SHA256=
FIREBASE_PROJECT_ID=

# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=

# ── Tenjin ───────────────────────────────────────────────────────────────────
# Two different credentials, from two different pages of the Tenjin console:
#
#   TENJIN_*_SDK_KEY        client config, ships inside the mobile binary.
#                           Lives here only. NEVER written to SSM.
#   TENJIN_SERVER_API_KEY   a secret, used by GoGo-BE (LNK-BE-003) to build
#                           tracking URLs. Entered through
#                           `setup-env.sh <env> --optional`, stored in SSM at
#                           /gogo/<env>/backend/tenjin/server-api-key.
#
# Filling in the SDK keys does not satisfy the server key.
TENJIN_IOS_SDK_KEY=
TENJIN_ANDROID_SDK_KEY=
IOS_STORE_URL=
ANDROID_STORE_URL=

# ── Production VPS ───────────────────────────────────────────────────────────
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/gogo
HEALTH_URL=

# ── AWS ──────────────────────────────────────────────────────────────────────
# Permission set role ARN developers assume through Identity Center.
DEVELOPER_SSO_PRINCIPAL_ARN=
